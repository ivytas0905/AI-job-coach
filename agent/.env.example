# All backend settings use the RESUME_ prefix.
RESUME_ENVIRONMENT=development
RESUME_DEBUG=true
RESUME_LOG_LEVEL=INFO
RESUME_HOST=0.0.0.0
RESUME_PORT=8000

# Select deepseek, openai, or togetherai. Existing runs persist their provider/model.
RESUME_LLM_PROVIDER=deepseek
RESUME_LLM_MODEL=deepseek-chat
RESUME_DEEPSEEK_API_KEY=your-deepseek-api-key-here
RESUME_DEEPSEEK_BASE_URL=https://api.deepseek.com
RESUME_OPENAI_API_KEY=your-openai-api-key-here
RESUME_OPENAI_BASE_URL=https://api.openai.com/v1
RESUME_TOGETHER_API_KEY=your-together-api-key-here
RESUME_TOGETHER_BASE_URL=https://api.together.xyz/v1
RESUME_LLM_TIMEOUT_SECONDS=30

RESUME_CORS_ORIGINS=["http://localhost:3000"]
RESUME_MAX_FILE_SIZE=10485760
RESUME_UPLOAD_DIR=uploads

# Development database; production uses PostgreSQL and Alembic migrations.
RESUME_DATABASE_URL=sqlite+aiosqlite:///./ai_job_coach.db
RESUME_DATABASE_ECHO=false
RESUME_DATABASE_AUTO_CREATE=false

RESUME_OBJECT_STORAGE_BACKEND=local
RESUME_OBJECT_STORAGE_ROOT=object-storage
